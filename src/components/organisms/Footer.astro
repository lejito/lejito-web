---
import BoltIcon from "@atoms/icons/BoltIcon.astro";
import CalendarIcon from "@atoms/icons/CalendarIcon.astro";
import GithubIcon from "@atoms/icons/GithubIcon.astro";
import UserIcon from "@atoms/icons/UserIcon.astro";
import { SITE } from "@config/site";
---

<footer
  class="flex flex-col gap-3 justify-center items-center py-4 text-muted"
>
  <div class="flex gap-4 my-4">
    <span class="w-8 h-1 rounded-l bg-divider transition"
    ></span>
    <span class="w-8 h-1 bg-divider transition"></span>
    <span class="w-8 h-1 rounded-r bg-divider transition"
    ></span>
  </div>
  <div class="flex flex-col items-center gap-2 text-sm transition">
    <span class="flex items-center gap-1.5">
      <UserIcon size="16" />
      {SITE.owner}
    </span>
    <span class="flex items-center gap-1.5">
      <CalendarIcon size="16" />
      {new Date().getFullYear()}
    </span>
    <a
      href={SITE.repo}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5"
    >
      <GithubIcon size="16" />
      lejito-web
    </a>
  </div>
  <BoltIcon size="32" class="transition" />
</footer>
