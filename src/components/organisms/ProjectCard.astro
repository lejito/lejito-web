---
interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  repo?: string;
  image?: string;
  featured?: boolean;
}

const { title, description, tags, url, repo, featured } = Astro.props;
---

<article
  class:list={[
    "flex flex-col gap-4 rounded-xl border p-6 transition",
    "border-outline",
    "bg-surface dark:bg-surface/60",
    featured && "ring-2 ring-custom-primary/40",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-lg font-bold leading-tight">{title}</h3>
    {
      featured && (
        <span class="shrink-0 rounded-full bg-custom-primary px-2.5 py-0.5 text-xs font-medium text-custom-light">
          Destacado
        </span>
      )
    }
  </div>

  <p class="text-sm text-secondary leading-relaxed">
    {description}
  </p>

  <div class="flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <span class="rounded-md bg-surface-raised px-2 py-0.5 text-xs font-medium text-emphasis">
          {tag}
        </span>
      ))
    }
  </div>

  {
    (url || repo) && (
      <div class="flex items-center gap-4 mt-auto pt-2">
        {url && (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-custom-primary hover:opacity-70 transition-opacity"
          >
            Ver sitio →
          </a>
        )}
        {repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-muted hover:opacity-70 transition-opacity"
          >
            Repositorio →
          </a>
        )}
      </div>
    )
  }
</article>
