---
import Logo from "@molecules/Logo.astro";
import SocialLink from "@atoms/SocialLink.astro";
import LinkedinIcon from "@atoms/icons/LinkedinIcon.astro";
import GithubIcon from "@atoms/icons/GithubIcon.astro";
import InstagramIcon from "@atoms/icons/InstagramIcon.astro";
import TwitterIcon from "@atoms/icons/TwitterIcon.astro";
import ThemeSwitch from "@molecules/ThemeSwitch.astro";
import MenuIcon from "@atoms/icons/MenuIcon.astro";
import CloseIcon from "@atoms/icons/CloseIcon.astro";
import { SOCIAL_LINKS, NAV_LINKS } from "@config/site";

const iconMap = {
  linkedin: LinkedinIcon,
  github: GithubIcon,
  instagram: InstagramIcon,
  twitter: TwitterIcon,
} as const;

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 w-full z-50 h-20 flex items-center justify-between transition px-4 md:px-8 py-4"
>
  <!-- Logo -->
  <Logo />

  <!-- Desktop Navigation -->
  <nav
    id="desktop-nav"
    class="hidden lg:flex items-center gap-1 text-nowrap text-sm xl:text-base border border-custom-primary/30 rounded-full px-1 py-1 bg-surface relative transition-colors"
  >
    <div
      id="nav-pill"
      class="absolute rounded-full bg-custom-primary pointer-events-none"
      style="opacity:0"
      aria-hidden="true"
    ></div>
    {
      NAV_LINKS.map(({ href, label }) => {
        const isActive = currentPath === href;
        return (
          <a
            href={href}
            class:list={[
              "px-4 py-1.5 rounded-full font-medium relative z-10",
              isActive ? "text-white" : "",
            ]}
            aria-current={isActive ? "page" : undefined}
            data-nav-link
          >
            {label}
          </a>
        );
      })
    }
  </nav>

  <!-- Desktop Social Links & Theme Switch -->
  <div class="hidden lg:flex items-center gap-6 xl:gap-10">
    <div class="flex items-center gap-4 lg:gap-6">
      {
        SOCIAL_LINKS.map(({ href, label, icon }) => {
          const Icon = iconMap[icon];
          return (
            <SocialLink href={href} label={label}>
              <Icon />
            </SocialLink>
          );
        })
      }
    </div>

    <ThemeSwitch />
  </div>

  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-button"
    class="lg:hidden p-2 rounded-full hover:bg-surface-raised transition-colors"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <MenuIcon size="24" />
  </button>
</header>

<!-- Mobile backdrop -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 z-40 bg-black/40 lg:hidden"
  aria-hidden="true"
></div>

<!-- Mobile side drawer -->
<aside
  id="mobile-menu"
  class="fixed top-0 right-0 h-dvh w-[min(320px,88vw)] z-50 flex flex-col bg-surface border-l border-divider shadow-2xl lg:hidden"
  aria-hidden="true"
>
  <!-- Drawer header — solo botón de cierre, alineado con el header principal -->
  <div class="flex items-center justify-end h-20 px-5 border-b border-divider shrink-0">
    <button
      id="mobile-close-button"
      class="p-2 rounded-full hover:bg-surface-raised transition-colors"
      aria-label="Cerrar menú"
    >
      <CloseIcon size="22" />
    </button>
  </div>

  <!-- Nav links -->
  <nav class="flex flex-col gap-1 p-3 pt-4">
    {
      NAV_LINKS.map(({ href, label }) => {
        const isActive = currentPath === href;
        return (
          <a
            href={href}
            class:list={[
              "px-4 py-3 rounded-xl font-medium text-base",
              isActive
                ? "bg-custom-primary text-white"
                : "hover:bg-surface-raised",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {label}
          </a>
        );
      })
    }
  </nav>

  <!-- Spacer -->
  <div class="flex-1"></div>

  <!-- Bottom: social links + theme switch -->
  <div class="px-5 py-6 border-t border-divider flex items-center justify-between">
    <div class="flex items-center gap-5">
      {
        SOCIAL_LINKS.map(({ href, label, icon }) => {
          const Icon = iconMap[icon];
          return (
            <SocialLink href={href} label={label}>
              <Icon />
            </SocialLink>
          );
        })
      }
    </div>
    <ThemeSwitch />
  </div>
</aside>

<style>
  #desktop-nav a[data-nav-link] {
    transition: color var(--default-transition-duration) ease-out;
  }

  #nav-pill {
    transition:
      left 280ms cubic-bezier(0.4, 0, 0.2, 1),
      top 280ms cubic-bezier(0.4, 0, 0.2, 1),
      width 280ms cubic-bezier(0.4, 0, 0.2, 1),
      height 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 150ms ease;
  }

  /* Cerrado por defecto — usando translate (propiedad CSS moderna, no transform) */
  #mobile-menu {
    translate: 100% 0;
    transition-property: translate, background-color, border-color;
    transition-duration: var(--default-transition-duration);
    transition-timing-function: var(--default-transition-timing);
  }

  #mobile-menu.is-open {
    translate: 0 0;
  }

  #mobile-backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--default-transition-duration) var(--default-transition-timing);
  }

  #mobile-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  #mobile-menu nav a,
  #mobile-menu > div {
    transition-property: background-color, color, border-color;
    transition-duration: var(--default-transition-duration);
    transition-timing-function: var(--default-transition-timing);
  }
</style>

<script>
  let controller = new AbortController();

  function setupHeader() {
    controller.abort();
    controller = new AbortController();
    const signal = controller.signal;

    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu") as HTMLElement | null;
    const mobileBackdrop = document.getElementById("mobile-backdrop");
    const mobileCloseButton = document.getElementById("mobile-close-button");

    function setMenuOpen(open: boolean) {
      mobileMenu?.classList.toggle("is-open", open);
      mobileMenu?.setAttribute("aria-hidden", String(!open));
      mobileBackdrop?.classList.toggle("is-open", open);
      mobileMenuButton?.setAttribute("aria-expanded", String(open));
      mobileMenuButton?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    }

    mobileMenuButton?.addEventListener(
      "click",
      () => {
        const isOpen = mobileMenuButton.getAttribute("aria-expanded") === "true";
        setMenuOpen(!isOpen);
      },
      { signal },
    );

    mobileCloseButton?.addEventListener(
      "click",
      () => setMenuOpen(false),
      { signal },
    );

    mobileBackdrop?.addEventListener(
      "click",
      () => setMenuOpen(false),
      { signal },
    );

    // Restaurar estado abierto tras navegación (sin animación de slide)
    if (sessionStorage.getItem("mobile-menu-open")) {
      sessionStorage.removeItem("mobile-menu-open");
      if (mobileMenu) {
        mobileMenu.style.transitionProperty = "none";
        mobileMenu.classList.add("is-open");
        mobileMenu.getBoundingClientRect();
        mobileMenu.style.transitionProperty = "";
      }
      mobileBackdrop?.classList.add("is-open");
      mobileMenuButton?.setAttribute("aria-expanded", "true");
      mobileMenuButton?.setAttribute("aria-label", "Cerrar menú");
    }

    // Al navegar, mantener el menú abierto
    mobileMenu?.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener(
        "click",
        () => sessionStorage.setItem("mobile-menu-open", "true"),
        { signal },
      );
    });

    // === Sliding nav pill ===
    const nav = document.getElementById("desktop-nav");
    const pill = document.getElementById("nav-pill") as HTMLElement | null;
    if (nav && pill) {
      const links = Array.from(
        nav.querySelectorAll<HTMLElement>("[data-nav-link]"),
      );
      const activeLink = nav.querySelector<HTMLElement>(
        "[aria-current='page']",
      );
      const activeIndex = activeLink ? links.indexOf(activeLink) : -1;

      function positionPill(el: HTMLElement, instant = false) {
        const navRect = nav!.getBoundingClientRect();
        const elRect = el.getBoundingClientRect();
        if (instant) {
          pill!.style.transition = "none";
        }
        pill!.style.left = `${elRect.left - navRect.left}px`;
        pill!.style.top = `${elRect.top - navRect.top}px`;
        pill!.style.width = `${elRect.width}px`;
        pill!.style.height = `${elRect.height}px`;
        if (instant) {
          pill!.getBoundingClientRect();
          pill!.style.transition = "";
        }
      }

      const lgQuery = window.matchMedia("(min-width: 1024px)");

      if (lgQuery.matches && activeLink) {
        const prevStr = sessionStorage.getItem("nav-prev-index");
        sessionStorage.removeItem("nav-prev-index");
        const prevIndex = prevStr !== null ? parseInt(prevStr, 10) : -1;
        const prevLink =
          prevIndex >= 0 && prevIndex !== activeIndex
            ? links[prevIndex]
            : null;

        if (prevLink) {
          positionPill(prevLink, true);
          pill.style.opacity = "1";
          requestAnimationFrame(() =>
            requestAnimationFrame(() => positionPill(activeLink)),
          );
        } else {
          positionPill(activeLink, true);
          pill.style.opacity = "1";
        }
      } else {
        sessionStorage.removeItem("nav-prev-index");
      }

      // Al redimensionar a desktop, reposicionar la pastilla correctamente
      lgQuery.addEventListener(
        "change",
        (e) => {
          if (e.matches && activeLink) {
            pill!.style.transition = "none";
            positionPill(activeLink);
            pill!.style.opacity = "1";
            pill!.getBoundingClientRect();
            pill!.style.transition = "";
          } else {
            pill!.style.opacity = "0";
          }
        },
        { signal },
      );

      links.forEach((link) => {
        link.addEventListener(
          "click",
          () => sessionStorage.setItem("nav-prev-index", String(activeIndex)),
          { signal },
        );
      });
    }
  }

  document.addEventListener("astro:page-load", setupHeader);
</script>
