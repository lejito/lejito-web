---
import lejitoLogo from "@images/lejito-logo.svg";
import SocialLink from "@components/SocialLink.astro";
import LinkedinIcon from "@components/icons/LinkedinIcon.astro";
import GithubIcon from "@components/icons/GithubIcon.astro";
import InstagramIcon from "@components/icons/InstagramIcon.astro";
import TwitterIcon from "@components/icons/TwitterIcon.astro";
import ThemeSwitch from "@components/ThemeSwitch.astro";
---

<header
  class="fixed top-0 left-0 w-full inset-x-0 z-100 h-20 flex items-center justify-between px-8 py-4 shadow-md backdrop-blur"
>
  <a href="/" class="flex items-center gap-4">
    <img src={lejitoLogo.src} alt="Lejito Logo" class="h-16 w-16 drop-shadow-xs drop-shadow-gray-700 transition-all duration-300" />
    <div class="relative flex items-center transition-colors duration-500">
      <div class="flex flex-row items-center gap-2 text-shadow-xs">
        <h1 class="text-lg font-bold leading-tight transition-colors duration-500">Alejandro Cordoba Rios</h1>
        <span class="text-xs font-medium opacity-70 leading-none transition-colors duration-500">(@lejito)</span>
      </div>
    </div>
  </a>
  <nav class="flex items-center gap-10">
    <a href="/">Inicio</a>
    <a href="/sobre-mi">Sobre mí</a>
    <a href="/proyectos">Proyectos</a>
    <a href="/contacto">Contacto</a>
  </nav>
  <div class="flex items-center gap-10">
    <div class="flex items-center gap-6">
      <SocialLink href="https://linkedin.com/in/alejocrrs" label="LinkedIn">
        <LinkedinIcon />
      </SocialLink>

      <SocialLink href="https://github.com/lejito" label="GitHub">
        <GithubIcon />
      </SocialLink>

      <SocialLink href="https://instagram.com/alejocrrs" label="Instagram">
        <InstagramIcon />
      </SocialLink>

      <SocialLink href="https://x.com/alejocrrs" label="X (Twitter)">
        <TwitterIcon />
      </SocialLink>
    </div>

    <ThemeSwitch />
  </div>
</header>
