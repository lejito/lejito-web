---
import SunIcon from "@atoms/icons/SunIcon.astro";
import MoonIcon from "@atoms/icons/MoonIcon.astro";
---

<button
  class="theme-toggle relative flex items-center w-18 h-10 p-1 rounded-full hover:opacity-80 cursor-pointer transition"
  type="button"
  aria-label="Cambiar tema"
>
  <div
    class="icon-container flex items-center justify-center w-8 h-8 p-1 bg-white rounded-full shadow-md transition-transform"
  >
    <div class="sun-icon absolute transition-opacity text-custom-dark">
      <SunIcon />
    </div>
    <div class="moon-icon absolute transition-opacity text-custom-dark">
      <MoonIcon />
    </div>
  </div>
</button>

<style>
  .theme-toggle {
    position: relative;
  }

  .theme-toggle::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--toggle-gradient-light);
    opacity: 1;
    transition: opacity var(--default-transition-duration)
      var(--default-transition-timing);
  }

  .theme-toggle::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--toggle-gradient-dark);
    opacity: 0;
    transition: opacity var(--default-transition-duration)
      var(--default-transition-timing);
  }

  .icon-container {
    position: relative;
    z-index: 1;
    transform: translateX(0);
  }

  .sun-icon {
    opacity: 1;
  }

  .moon-icon {
    opacity: 0;
  }

  :global(.dark) .theme-toggle::before {
    opacity: 0;
  }

  :global(.dark) .theme-toggle::after {
    opacity: 1;
  }

  :global(.dark) .sun-icon {
    opacity: 0;
  }

  :global(.dark) .moon-icon {
    opacity: 1;
  }

  :global(.dark) .icon-container {
    transform: translateX(32px);
  }
</style>

<script>
  function setupThemeToggles() {
    const html = document.documentElement;
    document.querySelectorAll(".theme-toggle").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const newTheme = html.classList.contains("dark") ? "light" : "dark";
        html.classList.toggle("dark", newTheme === "dark");
        localStorage.setItem("theme", newTheme);
      });
    });
  }

  document.addEventListener("astro:page-load", setupThemeToggles);
</script>
