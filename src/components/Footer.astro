---
import BoltIcon from "./icons/BoltIcon.astro";
---

<footer
  class="flex flex-col gap-3 justify-center items-center py-4 text-gray-500 dark:text-gray-400"
>
  <div class="flex gap-4 my-4">
    <span
      class="w-8 h-1 rounded-l bg-gray-300 dark:bg-gray-700 transition-all duration-500"
    ></span>
    <span
      class="w-8 h-1 bg-gray-300 dark:bg-gray-700 transition-all duration-500"
    ></span>
    <span
      class="w-8 h-1 rounded-r bg-gray-300 dark:bg-gray-700 transition-all duration-500"
    ></span>
  </div>
  <p class="text-center text-sm transition-all duration-500">
    &copy; {new Date().getFullYear()} ~ Alejandro Cordoba Rios. Todos los derechos reservados.
  </p>
  <BoltIcon size="32" class="transition-all duration-500" />
</footer>
