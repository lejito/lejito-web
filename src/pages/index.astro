---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import enConstruccionImg from "@images/en-construccion.webp";
---

<Layout>
  <h2 class="text-center text-2xl font-bold transition">Próximamente...</h2>

  <div class="mt-8 flex justify-center">
    <Image
      src={enConstruccionImg}
      alt="Página en construcción"
      class="max-h-80 w-auto rounded-lg shadow-md block"
    />
  </div>
</Layout>
