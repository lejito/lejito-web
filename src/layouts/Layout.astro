---
import { ClientRouter } from "astro:transitions";
import "@styles/global.css";
import Header from "@organisms/Header.astro";
import Footer from "@organisms/Footer.astro";
import { SITE } from "@config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const {
  title,
  description,
  image = "/og-image.jpg",
  keywords = SITE.defaultKeywords,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${SITE.owner} (@${SITE.nick})`
  : `Portafolio: ${SITE.owner} (@${SITE.nick})`;

const today = new Date();
let age = today.getFullYear() - SITE.birthDate.getFullYear();
const monthDiff = today.getMonth() - SITE.birthDate.getMonth();
if (
  monthDiff < 0 ||
  (monthDiff === 0 && today.getDate() <= SITE.birthDate.getDate())
) {
  age -= 1;
}

const pageDescription = description
  ? description
  : `Mi nombre es Alejandro Cordoba Rios y tengo ${age} años. Soy un Ingeniero de Sistemas y Desarrollador Web apasionado por la tecnología y la innovación. Vivo en Medellín, Colombia.`;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
      function applyTheme() {
        const theme =
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.classList.remove("dark", "light");
        document.documentElement.classList.add(theme);
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={SITE.owner} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Lejito" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="robots" content="index, follow" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1a212f"
      media="(prefers-color-scheme: dark)"
    />

    <ClientRouter />
  </head>
  <body class="overflow-x-hidden antialiased">
    <Header />

    <main class="mt-20 p-8">
      <slot />
    </main>

    <Footer />
  </body>
</html>
